classDiagram

    %% ─────────────── MODELOS ───────────────
    class Producto {
        +string Codigo
        +string Nombre
        +string Descripcion
        +DateTime FechaIngreso
        +DateTime FechaCaducidad
        +string AgregadoPor
    }

    class Usuario {
        +string Nombre
        +string Contrasena
        +string Rol
        +int ProductosAgregados
    }

    %% ─────────────── DATOS ───────────────
    class DatosSistema {
        +static List~Usuario~ usuarios
        +static List~Producto~ productos
    }

    %% ─────────────── FORMULARIOS ───────────────
    class frmLogin {
        +frmLogin()
        -frmLogin_Load()
        -btnInicioSesion_Click()
    }

    class frmGerente {
        -Usuario usuarioActual
        +frmGerente()
        +frmGerente(Usuario u)
        -frmGerente_Load()
        -btnAgregar_Click()
        -btnEliminar_Click()
        -btnEditar_Click()
        -btnDesempeno_Click()
        -btnMostrar_Click()
        -btnCerrarSesion_Click()
        -btnSalir_Click()
        +CargarProductos()
    }

    class frmEmpleado {
        -Usuario usuarioActual
        +frmEmpleado()
        +frmEmpleado(Usuario u)
        -frmEmpleado_Load()
        -btnAgregar_Click()
        -btnCerrarSesion_Click()
        -btnSalir_Click()
        +CargarProductos()
    }

    %% ─────────────── RELACIONES ───────────────
    DatosSistema "1" o-- "many" Usuario : contiene
    DatosSistema "1" o-- "many" Producto : contiene

    frmLogin ..> DatosSistema : usa
    frmLogin ..> frmGerente : abre si Gerente
    frmLogin ..> frmEmpleado : abre si Empleado

    frmGerente --> Usuario : usuarioActual
    frmGerente ..> DatosSistema : usa
    frmGerente ..> Producto : crea

    frmEmpleado --> Usuario : usuarioActual
    frmEmpleado ..> DatosSistema : usa
    frmEmpleado ..> Producto : crea